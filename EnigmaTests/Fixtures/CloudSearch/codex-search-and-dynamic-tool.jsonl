{"method": "item/completed", "params": {"item": {"type": "webSearch", "id": "item-4", "query": "Apple WWDC 2026 dates official", "action": {"type": "search", "query": "Apple WWDC 2026 dates official", "queries": null}, "results": [{"type": "text_result", "domain": "www.apple.com", "ref_id": "turn0search0", "snippet": "Image: Artwork representing Apple’s 2026 Worldwide Developers Conference. CUPERTINO, CALIFORNIA Apple today announced it will host its annual Worldwide Developers Conference (WWDC) online from June", "title": "Apple’s Worldwide Developers Conference returns the week of June 8 - Apple", "url": "https://www.apple.com/newsroom/2026/03/apples-worldwide-developers-conference-returns-the-week-of-june-8/"}, {"type": "text_result", "domain": "www.apple.com", "ref_id": "turn0search1", "snippet": "UPDATE May 18, 2026 ... Apple today unveiled an exciting lineup for its annual Worldwide Developers Conference (WWDC), taking place June 8-12.", "title": "Apple kicks off Worldwide Developers Conference on June 8 - Apple", "url": "https://www.apple.com/newsroom/2026/05/apple-kicks-off-worldwide-developers-conference-on-june-8/"}, {"type": "text_result", "domain": "developer.apple.com", "ref_id": "turn0search2", "snippet": "## WWDC26: June 8-12, 2026 ... Be there for the reveal of the latest Apple tools, frameworks, and features.", "title": "WWDC26: June 8-12, 2026 - Latest News - Apple Developer", "url": "https://developer.apple.com/news/?id=yi8qj25k"}, {"type": "text_result", "domain": "www.apple.com", "ref_id": "turn0search3", "snippet": "UPDATE May 18, 2026 ... Apple today unveiled an exciting lineup for its annual Worldwide Developers Conference (WWDC), taking place June 8-12.", "title": "Apple kicks off Worldwide Developers Conference on June 8 - Apple (CA)", "url": "https://www.apple.com/ca/newsroom/2026/05/apple-kicks-off-worldwide-developers-conference-on-june-8/"}, {"type": "text_result", "domain": "images.apple.com", "ref_id": "turn0search4", "snippet": "UPDA